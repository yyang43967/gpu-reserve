# Copy to .env and adjust. Never commit real secrets.

# --- Docker Compose (local) ---
POSTGRES_USER=gpureserve
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gpureserve

# --- Backend (also read from backend/.env when running on the host) ---
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://gpureserve:change-me@localhost:5432/gpureserve
# Seconds a request waits for a free database connection before a 503 with Retry-After.
DATABASE_POOL_TIMEOUT_SECONDS=3
DATABASE_BUSY_RETRY_AFTER_SECONDS=2
REDIS_URL=redis://localhost:6379/0
# Availability and slot search read GPU allocations through Redis; false reads Postgres
# every time. The TTL only bounds staleness if an invalidation is lost.
AVAILABILITY_CACHE_ENABLED=true
AVAILABILITY_CACHE_TTL_SECONDS=300
# Counts cache hits in Redis, at the cost of a round trip per read. Load tests only.
AVAILABILITY_CACHE_STATS=false
CORS_ORIGINS=http://localhost:5173
# Access-token signing key, at least 32 bytes. Generate one with: openssl rand -hex 32
# Docker Compose falls back to a development-only key when this is empty; running
# the API on the host requires a value here.
JWT_SECRET=
# Only for plain-HTTP local development. Leave unset (true) anywhere served over HTTPS.
REFRESH_COOKIE_SECURE=false

# --- Bookings ---
# Weekly GPU-hour quotas run Monday 00:00 to Monday 00:00 in this IANA zone, for every
# lab. Its offsets must be whole half hours.
QUOTA_TIMEZONE=America/Los_Angeles

# --- Demo data (python -m app.seed) ---
# The seed reads ADMIN_PASSWORD like create-admin. Students get SEED_STUDENT_PASSWORD;
# leave it empty and only the admin can sign in.
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=

# --- Email ---
# smtp (Mailpit locally) or ses (production, with the instance role).
EMAIL_BACKEND=smtp
EMAIL_FROM=GPU Reserve <no-reply@gpureserve.dev>
# Running the worker on the host with Mailpit in Compose: localhost and 1025.
SMTP_HOST=localhost
SMTP_PORT=1025
# Links in emails point here.
FRONTEND_URL=http://localhost:5173

# --- Object storage (SeaweedFS locally, S3 in production) ---
# The application's identity, limited to the uploads bucket. Docker Compose falls back
# to development-only keys when these are empty.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=gpu-reserve-uploads
# Where the API reaches storage, and where browsers send uploads. Leave both empty for
# AWS S3. Running the API on the host, both are http://localhost:8333.
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# --- Knowledge base and embeddings ---
# Needed to load the knowledge base (python -m app.rag.ingest) and for policy search.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must stay 1536, the width of the embedding column.
EMBEDDING_DIMENSIONS=1536
# Sections returned per search, and the minimum cosine similarity for a result. The
# threshold was measured for EMBEDDING_MODEL; changing the model means measuring it again.
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
# Where the documents are. Defaults to the repository's kb/ on the host; the image sets
# /app/kb.
# KB_DIR=

# --- Assistant ---
# "<provider>:<model>": openai uses OPENAI_API_KEY, anthropic uses ANTHROPIC_API_KEY,
# vllm uses VLLM_BASE_URL and VLLM_API_KEY.
ASSISTANT_MODEL=openai:gpt-5.4-mini-2026-03-17
ANTHROPIC_API_KEY=
# An OpenAI-compatible vLLM server (https://<host>/v1). Its served model name must equal
# the model part of ASSISTANT_MODEL.
VLLM_BASE_URL=
VLLM_API_KEY=
# true or false for models whose chat template has a thinking switch (Qwen3). Leave
# empty to use the template's default.
VLLM_ENABLE_THINKING=
# Langfuse tracing. Leave the keys empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend ---
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

