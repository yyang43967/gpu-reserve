# Copy to .env and adjust. Never commit real secrets.

# --- Docker Compose (local) ---
POSTGRES_USER=gpureserve
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gpureserve

# --- Backend (also read from backend/.env when running on the host) ---
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://gpureserve:change-me@localhost:5432/gpureserve
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
# Access-token signing key, at least 32 bytes. Generate one with: openssl rand -hex 32
# Docker Compose falls back to a development-only key when this is empty; running
# the API on the host requires a value here.
JWT_SECRET=
# Only for plain-HTTP local development. Leave unset (true) anywhere served over HTTPS.
REFRESH_COOKIE_SECURE=false

# --- Object storage (SeaweedFS locally, S3 in production) ---
# The application's identity, limited to the uploads bucket. Docker Compose falls back
# to development-only keys when these are empty.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=gpu-reserve-uploads

# --- Frontend ---
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
