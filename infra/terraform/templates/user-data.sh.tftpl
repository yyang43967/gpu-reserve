#!/bin/bash
# First boot only (cloud-init). Prepares the host; the application is installed and
# updated by the deploy script, never here.
set -euo pipefail

# Swap as a safety net for short spikes (image pulls, migrations, package updates).
# Containers get no swap of their own (memswap_limit equals mem_limit in Compose).
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=${swap_mib} status=none
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi
swapon -a
echo 'vm.swappiness = 10' > /etc/sysctl.d/90-swap.conf
sysctl --system > /dev/null

dnf install -y docker

# Log rotation for every container, so logs cannot fill the disk.
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" }
}
JSON

# Docker Compose plugin, pinned and checked against its published SHA-256.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /tmp/docker-compose \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64"
echo "${compose_sha256}  /tmp/docker-compose" | sha256sum -c -
install -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
rm -f /tmp/docker-compose

systemctl enable --now docker

# Where the deploy script keeps the Compose project and its env file.
install -d -m 0750 -o root -g root ${app_dir}
