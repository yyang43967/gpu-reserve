# The API behind Caddy.
#
# API_SITE_ADDRESS is the API's hostname in production, for which Caddy obtains and
# renews a certificate on its own; ":80" serves plain HTTP for local checks.
# API_UPSTREAM is the API container on the Compose network.

{$API_SITE_ADDRESS::8080} {
	header {
		# HTTPS only for a year, for this hostname only (no includeSubDomains: other
		# names under the domain are not ours to commit to HTTPS).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The API serves JSON, not pages; nothing should frame it.
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Assistant runs answer with server-sent events. A compressor buffers its output,
	# so streaming responses are left uncompressed; everything else may be compressed.
	@compressible not {
		method POST
		path /api/v1/assistant/threads/*/messages /api/v1/assistant/threads/*/resume
	}
	encode @compressible zstd gzip

	reverse_proxy {$API_UPSTREAM:api:8000} {
		# Write each event to the client as soon as the API sends it.
		flush_interval -1
		# How long an idle connection to the API is kept for reuse; 2m is Caddy's
		# default. uvicorn closes idle connections after API_KEEP_ALIVE_SECONDS
		# (compose.yml), so the two are adjustable together (loadtest/results.md).
		transport http {
			keepalive {$API_UPSTREAM_KEEPALIVE:2m}
		}
	}
}
