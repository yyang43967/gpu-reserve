[Unit]
Description=Daily GPU Reserve database backup

[Timer]
# 09:30 UTC is the early morning in the Americas, the quietest time for labs there.
OnCalendar=*-*-* 09:30:00 UTC
RandomizedDelaySec=15m
# Runs at boot if the instance was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
